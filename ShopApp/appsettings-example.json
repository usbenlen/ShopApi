{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Shop.Infrastructure.Caching": "Debug" // Debug - показуються всі логи, Warning - тільки попередження
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=Your_Database;TrustServerCertificate=True;Trusted_Connection=True;",
    "RedisConnection": ".:6379"
  },
  "RabbitMq": {
    "Host": ".",
    "Port": 5672
  },
  "MongoDb": {
    "ConnectionString": "mongodb://name:passw@localhost:27017",
    "DatabaseName": "ShopDB"
  },
  "DirnameForFiles": {
    "Categories": "categories",
    "Products": "products"
  },
  "ProductSettings": {
    "MaxImages": 5
  },
  "ImageSettings": {
    "MaxSize": 10000, // 10 MB
    "MaxResolution": "1080x1080"
  },
  "JWT": {
    "Key": "YOUR_OWN_VERY_SECRET_KEY",
    "Issuer": "Shop.Api",
    "Audience": "ShopApiClient",
    "ExpiresMinutes": 15,
    "ExpiresRefreshTokenDay": 3
  },
  "Email": {
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "your_username",
    "Password": "your_password",
    "FromName": "ShopASP",
    "From": "test@example.com",
    "EnableSsl": true,
    "FrontendUrl": "https://your-frontend.example.com"
  },
  "AdminSeed": {
    "Email": "admin@shop.com",
    "Password": "UseExamplePassword52!"
  },
  "Caching": {
    "DefaultExpirationMinutes": 15,

    "Categories": {
      "ExpirationMinutes": 30
    },

    "Products": {
      "ExpirationMinutes": 30
    },

    "L1": {
      "ExpirationMinutes": 5,
      "SizeLimit": 10000
    },

    "Negative": {
      "ExpirationSeconds": 30
    }
  }
}
