{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=Your_Database;TrustServerCertificate=True;Trusted_Connection=True;"
  },
  "DirnameForFiles": {
    "Categories": "categories",
    "Products": "products"
  },
  "ProductSettings": {
    "MaxImages": 5
  },
  "ImageSettings": {
    "MaxSize": 10000, // 10 MB
    "MaxResolution": "1080x1080"
  },
  "JWT": {
    "Key": "YOUR_OWN_VERY_SECRET_KEY",
    "Issuer": "Shop.Api",
    "Audience": "ShopApiClient",
    "ExpiresMinutes": 15,
    "ExpiresRefreshTokenDay": 3
  },
  "Email": {
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "your_username",
    "Password": "your_password",
    "FromName": "ShopASP",
    "From": "test@example.com",
    "EnableSsl": true,
    "FrontendUrl": "https://your-frontend.example.com"
  },
  "AdminSeed": {
    "Email": "admin@shop.com",
    "Password": "UseExamplePassword52!"
  }
}
